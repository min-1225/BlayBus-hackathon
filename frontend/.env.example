# 이 파일을 .env.local 로 복사해서 사용하세요.
#   cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다.

# ─────────────────────────────────────────────
# Mock Backend
# ─────────────────────────────────────────────
# true  → MSW 가 가짜 Backend 역할 (Backend 없이 개발/데모 가능)
# false → 실제 Backend 호출
VITE_USE_MOCK=true

# ─────────────────────────────────────────────
# Backend 주소
# ─────────────────────────────────────────────
# 로컬 개발에서는 비워 둡니다.
# 비어 있으면 /api/v1/... 상대경로로 호출하고, Vite Proxy 가 8080 으로 넘겨서
# CORS 설정 없이도 동작합니다.
# 배포 시에만 실제 Backend URL 을 넣습니다. (예: https://api.example.com)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Vite Proxy 가 넘길 Backend 주소. 기본값 http://localhost:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080

# ─────────────────────────────────────────────
# 데모 설정
# ─────────────────────────────────────────────
# 이 키오스크가 설치된 터미널
VITE_KIOSK_DEPARTURE=동서울
